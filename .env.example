# Copy this file to .env and fill in values you want loaded into your shell
# whenever you `cd` into this repo (mise picks .env up via `_.file = ".env"`).
#
# .env is gitignored — never commit secrets.

# Guild Wars 2 API key. When set, the server uses it as the default for
# the two authed tools:
#   - get_wallet         — needs `account` + `wallet` scopes
#   - get_character_build — needs `account` + `characters` + `builds` scopes
# Per-tool `api_key` arguments still override this value when supplied.
# Generate at https://account.arena.net/applications.
# Format: 72-char hex with hyphens (8-4-4-4-20-8-4-4-4-20).
# GW2_API_KEY=

# Tracing filter passed to the binary. Examples:
#   info                          # default
#   gw2_mcp=debug                 # verbose only for our own crate
#   gw2_mcp=trace,reqwest=debug   # trace HTTP calls
# RUST_LOG=info

# Override the GW2 v2 base URL (only useful for tests / proxies).
# GW2_API_BASE_URL=https://api.guildwars2.com/v2

# Override the GW2 wiki API URL.
# GW2_WIKI_API_URL=https://wiki.guildwars2.com/api.php

# ── Search index ────────────────────────────────────────────────────────────
# Local SQLite/FTS5 index backing the `search_*` tools. See README.

# Override the OS-default cache directory for `index.sqlite`.
# GW2_CACHE_DIR=

# Disable the search index entirely. The `search_*` tools return a
# `SearchDisabled` error; the rest of the server keeps working. Useful for
# ephemeral / read-only environments (Docker, CI, etc.).
# GW2_NO_SEARCH_INDEX=false

# Include items in the background indexing pass. Heavy: ~85k entries,
# ~5 minutes of API calls, ~50 MB on disk. Off by default — opt in when
# you actually want item search.
# GW2_WITH_ITEMS=false

# Force a full re-index on startup even when the cached build number
# matches the live /v2/build. Use after schema changes or to rebuild a
# corrupt index.
# GW2_REBUILD_INDEX=false

# ── macOS / CrossOver / Whisky ──────────────────────────────────────────────
# Override Mumble Link bottle auto-discovery — pin to a specific bottle
# name if you have multiple GW2 installs or a custom-named bottle that
# auto-detect picks wrong. Match the bottle's directory name as shown by
# `gw2-mcp doctor`.
# GW2_BOTTLE="Guild Wars 2"

# Disable the Mumble Link reader entirely (no auto-spawned helper, no
# /dev/shm probe). Use for Docker / headless / remote MCP deployments
# where GW2 isn't on the same host. The four nav tools then return a
# clean "not connected" error; everything else works.
# GW2_NO_MUMBLE_LINK=false
